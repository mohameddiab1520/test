# Gateway Configuration

# Server
PORT=3000

# Service URLs
AUTH_SERVICE_URL=http://localhost:8083
SESSION_SERVICE_URL=http://localhost:8080
SYNC_SERVICE_URL=http://localhost:8081
ASSET_SERVICE_URL=http://localhost:8082
PRESENCE_SERVICE_URL=http://localhost:8084
VOICE_SERVICE_URL=http://localhost:8085
ANALYTICS_SERVICE_URL=http://localhost:8086

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Environment
NODE_ENV=development
