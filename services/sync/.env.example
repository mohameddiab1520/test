# Sync Service Configuration

# Server
PORT=8081

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Logging
LOG_LEVEL=info

# Operation Transform
MAX_OPERATIONS_HISTORY=1000
OPERATION_TIMEOUT=30000

# Heartbeat
HEARTBEAT_INTERVAL=30000
