# Conflict Resolution Service Configuration

# Server
PORT=8088

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=unity_collab
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Conflict Resolution
DEFAULT_STRATEGY=last_write_wins
AUTO_RESOLVE_TIMEOUT=30
MAX_CONFLICT_HISTORY=1000

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
