# Session Service Configuration

# Server
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=unity_collab
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-in-production

# WebSocket
WS_PING_INTERVAL=30
WS_PONG_TIMEOUT=60

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
