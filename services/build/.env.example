# Build Service Configuration

# Server
PORT=8087

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=unity_collab
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Unity Build Settings
UNITY_PATH=/Applications/Unity/Hub/Editor
DEFAULT_UNITY_VERSION=2022.3.0f1

# Build Storage
BUILD_ARTIFACTS_PATH=./build-artifacts
S3_BUCKET=unity-collab-builds
AWS_REGION=us-east-1

# Workers
MAX_CONCURRENT_BUILDS=3
BUILD_TIMEOUT=3600

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
